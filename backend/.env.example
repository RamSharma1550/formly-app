# Backend environment variables for production (Railway)

# SQLite database path — update to persistent volume path on Railway:
# DATABASE_URL=sqlite:////app/data/formly.db
DATABASE_URL=sqlite:///./formly.db

# Comma-separated list of allowed frontend origins (your Vercel URL)
# Example: CORS_ORIGINS=https://formly-ramu.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional tag to identify the deployment environment
ENVIRONMENT=development
